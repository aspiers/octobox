<div id="comment-<%= comment.id %>" class="card-comment card mt-3">
  <div class="card-header media d-flex align-items-center text-muted">
    <%= image_tag(avatar_url(comment.author), width: 20, class: 'mr-3 align-self-center', alt: '') %>
    <div class="media-body">
      <b><%= link_to comment.author, Octobox.config.github_domain + '/' + comment.author_url_path, class: 'text-muted', target: '_blank', rel: 'noopener' %></b>
      commented <%= time_ago_in_words(comment.created_at) %> ago
      <%= link_to 'View on GitHub', comment.web_url, class: 'float-right', target: '_blank', rel: 'noopener' %>
    </div>
  </div>
  <div class="card-body markdown-body">
    <% if comment.body.present? %>
      <%= safe_markdown(comment.body) %>
    <% else %>
      <p><i>No description given.</i></p>
    <% end %>
  </div>
</div>

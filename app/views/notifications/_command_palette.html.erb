<div id="command-palette" class="modal" role="dialog" aria-labelledby="command-palette-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content command-palette-content">
      <h5 id="command-palette-title" class="sr-only">Go to sidebar item</h5>
      <div class="command-palette-search">
        <label for="command-palette-input" class="sr-only">Filter sidebar items</label>
        <input id="command-palette-input" class="form-control form-control-lg" type="text" role="combobox" aria-autocomplete="list" aria-controls="command-palette-results" aria-expanded="false" autocomplete="off" placeholder="Go to sidebar item…">
        <div id="command-palette-status" class="sr-only" aria-live="polite"></div>
      </div>
      <div id="command-palette-results" class="list-group list-group-flush" role="listbox" aria-label="Sidebar items"></div>
    </div>
  </div>
</div>

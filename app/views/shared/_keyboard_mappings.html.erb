<div class="keyboard-mappings-grid">
  <section class="keyboard-mappings-group" data-keyboard-group="navigation">
    <h6>Navigation</h6>
    <table class="keyboard-mappings">
      <tbody>
        <tr data-shortcut="list-navigation">
          <td class="keys"><div class="key">j</div> or <div class="key">k</div></td>
          <td>Move down or up the notification list</td>
        </tr>
        <tr data-shortcut="page-navigation">
          <td class="keys"><div class="key">n</div> or <div class="key">p</div></td>
          <td>Go to the next or previous results page</td>
        </tr>
        <tr data-shortcut="open-notification">
          <td class="keys"><div class="key">o</div> or <div class="key">Enter</div></td>
          <td>Open the current notification in a new window</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="keyboard-mappings-group" data-keyboard-group="search">
    <h6>Search and refresh</h6>
    <table class="keyboard-mappings">
      <tbody>
        <tr data-shortcut="focus-search">
          <td class="keys"><div class="key">/</div></td>
          <td>Focus notification search</td>
        </tr>
        <tr data-shortcut="refresh">
          <td class="keys"><div class="key">.</div> or <div class="key">r</div></td>
          <td>Refresh notifications</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="keyboard-mappings-group" data-keyboard-group="actions">
    <h6>Notification actions</h6>
    <table class="keyboard-mappings">
      <tbody>
        <tr data-shortcut="star">
          <td class="keys"><div class="key">s</div></td>
          <td>Star the current notification</td>
        </tr>
        <tr data-shortcut="mark">
          <td class="keys"><div class="key">x</div></td>
          <td>Mark or unmark the current notification</td>
        </tr>
        <tr data-shortcut="select-all">
          <td class="keys"><div class="key">a</div></td>
          <td>Select or deselect all notifications</td>
        </tr>
        <tr data-shortcut="archive">
          <td class="keys"><div class="key">y</div> or <div class="key">e</div></td>
          <td>Archive current or marked notifications</td>
        </tr>
        <tr data-shortcut="mute">
          <td class="keys"><div class="key">m</div></td>
          <td>Mute current or marked notifications</td>
        </tr>
        <tr data-shortcut="mark-read">
          <td class="keys"><div class="key">d</div></td>
          <td>Mark current or marked notifications read here and on GitHub</td>
        </tr>
        <tr data-shortcut="delete">
          <td class="keys"><div class="key">#</div></td>
          <td>Delete current or marked notifications</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="keyboard-mappings-group" data-keyboard-group="preview">
    <h6>Preview and general</h6>
    <table class="keyboard-mappings">
      <tbody>
        <tr data-shortcut="preview-scroll-page">
          <td class="keys"><div class="key">Space</div> or <div class="key">Backspace</div></td>
          <td>Scroll the notification preview down or up one page</td>
        </tr>
        <tr data-shortcut="preview-scroll-half-page">
          <td class="keys"><div class="key">Shift-PageDown</div> or <div class="key">Shift-PageUp</div></td>
          <td>Scroll the notification preview down or up half a page</td>
        </tr>
        <tr data-shortcut="help">
          <td class="keys"><div class="key">?</div></td>
          <td>Show this help menu</td>
        </tr>
        <tr data-shortcut="escape">
          <td class="keys"><div class="key">Esc</div></td>
          <td>Close the modal or preview, or clear filters</td>
        </tr>
      </tbody>
    </table>
  </section>
</div>
